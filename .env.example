# Optional. Without these the app runs on sample data only.
# Same Supabase project as homeloanagents-web (UFF Loans), service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to sign in. Without both, nobody can sign in (fails closed).
# Shared team password for v0. Use a long random passphrase.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Vesta (LOS). Same auth as the Pro Portal: "Authorization: Token <token>".
# The BETA/PROD switch at the top of the app picks which pair is used.
# BETA URL defaults to https://uff.beta.vesta.com/api/v1 if left empty.
VESTA_BETA_API_URL=
VESTA_BETA_API_TOKEN=
# Set both PROD variables to enable Vesta PROD.
VESTA_PROD_API_URL=
VESTA_PROD_API_TOKEN=
# Defaults to 26.4.
VESTA_API_VERSION=

# Support inbox (read only). Google Workspace receives support@homeloanagents.com.
# A service account with domain-wide delegation for https://www.googleapis.com/auth/gmail.readonly.
# The private key can be pasted with literal \n line breaks, or base64 encoded.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Defaults to support@homeloanagents.com.
SUPPORT_MAILBOX=
# Twilio texts to the support number, e.g. +15555550123.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SUPPORT_NUMBER=

# Sending approved messages. Off unless SENDING_ENABLED=true.
SENDING_ENABLED=
# Optional: comma-separated emails/phones. When set, nothing goes to anyone else (for testing).
SEND_ONLY_TO=
# Email through Resend. RESEND_FROM: "HomeLoanAgents <notifications@mail.homeloanagents.com>" (mail.homeloanagents.com is verified in Resend).
RESEND_API_KEY=
RESEND_FROM=
# Replies go here. Defaults to SUPPORT_MAILBOX.
RESEND_REPLY_TO=
# Texts through Twilio. Defaults to TWILIO_SUPPORT_NUMBER.
TWILIO_FROM=
# Emails go out in the homeloanagents-web layout with its Section 2.2 footer (lib/email-template.ts).
# COMPLIANCE_FOOTER is no longer used.
# Appended to every text. Defaults to "Reply STOP to opt out."
COMPLIANCE_SMS_FOOTER=

# Grok (xAI) writes the drafts from the templates. Same key name as homeloanagents-web.
# Without it, drafts use the plain templates.
XAI_API_KEY=
# Defaults to grok-3-mini.
XAI_MODEL=

# Vesta webhooks (https://admin.homeloanagents.com/api/webhooks/vesta).
# The secret Vesta signs with (HMAC-SHA256). Events for loans not on the HLA loan list are dropped.
VESTA_WEBHOOK_SECRET=
# Which Vesta environment the webhooks and the loan list sync are for. Defaults to beta.
VESTA_WEBHOOK_ENV=
# Any long random string. The 15 minute loan list sync (Netlify scheduled function) sends it.
CRON_SECRET=
