# Optional. Without these the app runs on sample data only.
# Same Supabase project as homeloanagents-web (UFF Loans), service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to sign in. Without both, nobody can sign in (fails closed).
# Shared team password for v0. Use a long random passphrase.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=

# Vesta (LOS). Same auth as the Pro Portal: "Authorization: Token <token>".
# The BETA/PROD switch at the top of the app picks which pair is used.
# BETA URL defaults to https://uff.beta.vesta.com/api/v1 if left empty.
VESTA_BETA_API_URL=
VESTA_BETA_API_TOKEN=
# Set both PROD variables to enable Vesta PROD.
VESTA_PROD_API_URL=
VESTA_PROD_API_TOKEN=
# Defaults to 26.4.
VESTA_API_VERSION=
