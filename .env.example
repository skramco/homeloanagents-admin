# Optional. Without these the app runs on sample data only.
# Same Supabase project as homeloanagents-web (UFF Loans), service role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required to sign in. Without both, nobody can sign in (fails closed).
# Shared team password for v0. Use a long random passphrase.
ADMIN_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=
